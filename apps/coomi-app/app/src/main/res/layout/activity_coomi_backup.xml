<!--
    Coomi 备份与导入二级页面：CoomiBackupActivity。
    提供「备份数据」与「导入备份」两个入口，风格与 Dashboard 一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/coomiPage"
    android:fitsSystemWindows="true"
    tools:context="app.coomi.CoomiBackupActivity">

    <!-- ── 顶栏 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/coomi_gutter"
        android:paddingEnd="@dimen/coomi_gutter">

        <ImageButton
            android:id="@+id/btn_backup_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/coomi_ic_back"
            android:tint="?attr/coomiText"
            android:contentDescription="@string/coomi_backup_back"/>

        <TextView
            style="@style/Coomi.Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/coomi_space_s"
            android:text="@string/coomi_backup_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/coomi_gutter"
            android:paddingEnd="@dimen/coomi_gutter"
            android:paddingTop="@dimen/coomi_space_xs"
            android:paddingBottom="@dimen/coomi_space_xl">

            <!-- ── 备份数据 ── -->
            <LinearLayout
                android:id="@+id/btn_backup_action"
                style="@style/Coomi.Row"
                android:background="@drawable/coomi_bg_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/coomi_space_l"
                android:paddingBottom="@dimen/coomi_space_l"
                android:layout_marginBottom="@dimen/coomi_space_s">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/coomi_bg_icon_tile">

                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:layout_gravity="center"
                        android:src="@drawable/coomi_ic_cube"
                        android:tint="?attr/coomiBlue"
                        android:contentDescription="@null"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/coomi_space_m"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Coomi.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="@string/coomi_backup_action"/>

                    <TextView
                        style="@style/Coomi.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/coomi_backup_action_desc"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/coomi_icon_s"
                    android:layout_height="@dimen/coomi_icon_s"
                    android:src="@drawable/coomi_ic_chevron_right"
                    android:tint="?attr/coomiText3"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <!-- ── 导入备份 ── -->
            <LinearLayout
                android:id="@+id/btn_backup_import"
                style="@style/Coomi.Row"
                android:background="@drawable/coomi_bg_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/coomi_space_l"
                android:paddingBottom="@dimen/coomi_space_l"
                android:layout_marginBottom="@dimen/coomi_space_s">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/coomi_bg_icon_tile">

                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:layout_gravity="center"
                        android:src="@drawable/coomi_ic_download"
                        android:tint="?attr/coomiBlue"
                        android:contentDescription="@null"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/coomi_space_m"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Coomi.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="@string/coomi_backup_import"/>

                    <TextView
                        style="@style/Coomi.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/coomi_backup_import_desc"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/coomi_icon_s"
                    android:layout_height="@dimen/coomi_icon_s"
                    android:src="@drawable/coomi_ic_chevron_right"
                    android:tint="?attr/coomiText3"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <TextView
                style="@style/Coomi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coomi_space_l"
                android:layout_marginBottom="@dimen/coomi_space_s"
                android:text="自动备份" />

            <LinearLayout
                style="@style/Coomi.Card">

                <LinearLayout style="@style/Coomi.Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Coomi.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="定时自动备份" />
                        <TextView
                            style="@style/Coomi.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="按计划保存会话、配置与扩展" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/switch_auto_backup"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:buttonTint="?attr/coomiBlue"
                        android:contentDescription="启用自动备份"
                        android:showText="false" />
                </LinearLayout>

                <View style="@style/Coomi.Divider" />

                <LinearLayout
                    android:id="@+id/row_auto_backup_directory"
                    style="@style/Coomi.Row"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:layout_marginEnd="@dimen/coomi_space_m"
                        android:contentDescription="@null"
                        android:src="@drawable/coomi_ic_folder"
                        android:tint="?attr/coomiBlue" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Coomi.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="导出目录" />
                        <TextView
                            android:id="@+id/txt_auto_backup_directory"
                            style="@style/Coomi.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="未选择" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="@dimen/coomi_icon_s"
                        android:layout_height="@dimen/coomi_icon_s"
                        android:layout_marginStart="@dimen/coomi_space_s"
                        android:contentDescription="@null"
                        android:src="@drawable/coomi_ic_chevron_right"
                        android:tint="?attr/coomiText3" />
                </LinearLayout>

                <View style="@style/Coomi.Divider" />

                <LinearLayout style="@style/Coomi.Row">
                    <TextView
                        style="@style/Coomi.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="备份间隔" />
                    <Spinner
                        android:id="@+id/spinner_auto_backup_interval"
                        android:layout_width="140dp"
                        android:layout_height="48dp"
                        android:gravity="end|center_vertical"
                        android:contentDescription="自动备份间隔" />
                </LinearLayout>

                <View style="@style/Coomi.Divider" />

                <LinearLayout style="@style/Coomi.Row">
                    <TextView
                        style="@style/Coomi.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="保留备份" />
                    <Spinner
                        android:id="@+id/spinner_auto_backup_keep"
                        android:layout_width="140dp"
                        android:layout_height="48dp"
                        android:gravity="end|center_vertical"
                        android:contentDescription="自动备份保留份数" />
                </LinearLayout>

                <View style="@style/Coomi.Divider" />

                <LinearLayout style="@style/Coomi.Row" android:paddingStart="20dp">
                    <CheckBox
                        android:id="@+id/check_auto_backup_charging"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:buttonTint="?attr/coomiBlue"
                        android:gravity="center_vertical"
                        android:text="仅充电时执行"
                        android:textColor="?attr/coomiText" />
                </LinearLayout>

                <View style="@style/Coomi.Divider" />

                <LinearLayout style="@style/Coomi.Row" android:paddingStart="20dp">
                    <CheckBox
                        android:id="@+id/check_auto_backup_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:buttonTint="?attr/coomiBlue"
                        android:gravity="center_vertical"
                        android:text="仅 Wi-Fi 时执行"
                        android:textColor="?attr/coomiText" />
                </LinearLayout>

                <View style="@style/Coomi.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/coomi_space_l">
                    <Button
                        android:id="@+id/btn_auto_backup_now"
                        style="@style/Coomi.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/coomi_button_height"
                        android:text="立即备份" />
                    <TextView
                        android:id="@+id/txt_auto_backup_status"
                        style="@style/Coomi.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/coomi_space_m"
                        android:lineSpacingExtra="2dp"
                        tools:text="上次：尚未执行&#10;下次：08-18 12:00" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── 提示 ── -->
            <TextView
                style="@style/Coomi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coomi_space_s"
                android:lineSpacingExtra="3dp"
                android:text="@string/coomi_backup_hint"/>

            <!-- ── 状态行 ── -->
            <TextView
                android:id="@+id/txt_backup_status"
                style="@style/Coomi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coomi_space_m"
                android:visibility="gone"
                tools:text="正在导入备份…"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
